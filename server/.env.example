PORT=5000
# IMPORTANT: Set CLIENT_URL to the exact production frontend URL (no trailing slash)
CLIENT_URL=https://vibematch-2-itmk.onrender.com
NODE_ENV=production

MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_long_random_jwt_secret
SPOTIFY_TOKEN_ENCRYPTION_KEY=your_64_character_hex_key_for_aes256

# Cloudinary (Persistent Photo Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service — Resend HTTPS REST API (Recommended for Render)
# Endpoint: https://api.resend.com/emails
# Free tier sandbox from-address: onboarding@resend.dev (delivers to your Resend account email)
# For custom domain sending, verify domain in Resend dashboard: https://resend.com/domains
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=VibeMatch <onboarding@resend.dev>

# Optional: Legacy SMTP fallback (Note: Render Free blocks outbound SMTP ports 25, 465, 587)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=your_resend_api_key

# Spotify OAuth & Music Integration
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:5000/api/music/spotify/callback

# Optional: Google Gemini AI (Match explanations & icebreakers fallback)
GEMINI_API_KEY=your_gemini_api_key

# Google OAuth (Sign In with Google)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://vibematch-lg51.onrender.com/api/auth/google/callback